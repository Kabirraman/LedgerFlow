# --- LEDGERFLOW backend ---

JWT_SECRET=Your JWT secret here

SEED_ADMIN_EMAIL= your admin email here
SEED_ADMIN_PASSWORD= your admin password here

DATABASE_URL=your Postgres connection string here

# Credentials for Razorpay and Google AI Studio are required to unlock real integrations. If you leave them blank, the app will run in sandbox mode with deterministic fallback logic instead of real AI reasoning.

RAZORPAY_KEY_ID=your Razorpay test key ID here
RAZORPAY_KEY_SECRET=your Razorpay test key secret here

RAZORPAY_WEBHOOK_SECRET=your Razorpay webhook secret here

RAZORPAY_MODE=test

PUBLIC_APP_URL=http://localhost:3000

GEMINI_API_KEY=your Google AI Studio API key here
GEMINI_MODEL=gemini-2.0-flash

# Defaults for other environment variables are in internal/config/config.go. You can override them here if you want to change them from the defaults, but you don't have to.

APP_ENV=local
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=30s
RUN_MIGRATIONS=true
JWT_TTL=12h
AUTO_RUN_PIPELINE=true
AUTO_EXECUTE_APPROVED=true
SEED_DEMO_DATA=true
VERIFICATION_POLL_INTERVAL=30s
VERIFICATION_TIMEOUT=30m
RAZORPAY_TIMEOUT=15s
RAZORPAY_MAX_RETRIES=2
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=20s
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.1
GEMINI_RETRIES=1
