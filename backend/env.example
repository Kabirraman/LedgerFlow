# --- LEDGERFLOW backend ---
#
# Mirrors internal/config/config.go exactly: every variable read there has a line
# here. Nothing in this file is required to build the binary (`go build` needs no
# environment at all) — this only matters when you run it.
#
# Three tiers below: things you must set, things that unlock real integrations,
# and things with safe defaults you can leave alone.

# ============================================================
# TIER 1 — required to run at all in a non-local environment
# ============================================================

# Signs every session JWT. In "local" mode a fixed dev secret is used if this is
# blank, so you can skip this for local dev. Anywhere else, Load() refuses to
# start without it. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=UAJHuoc0dholHfUaArKmz0X5PBxNAMEzeQB5lht0EpnBuUa9vyufwFbYeEd1LscD

# The seed administrator's login. Blank password defaults to "ledgerflow" in
# local mode only; required everywhere else. Change this before exposing the app.
SEED_ADMIN_EMAIL=admintest@cd gmail.com
SEED_ADMIN_PASSWORD=admintest

# Postgres connection string. The default below matches the Postgres a local
# `docker run` or `brew services start postgresql` would give you.
DATABASE_URL=postgresql://postgres:LedgerFlow%40123@db.wephgkweebgxmznqoqij.supabase.co:5432/postgres?sslmode=require

# ============================================================
# TIER 2 — optional, but unlocks real Razorpay + real AI reasoning
# ============================================================
#
# Leave this whole block blank and the app still runs end-to-end: it uses an
# in-process sandbox payment gateway (records what it would have sent, returns
# plausible responses, no network call) and deterministic fallback logic instead
# of the model (SRS 20.4). Every result is labelled as sandbox/deterministic
# rather than presented as a real test-mode result (SRS 25.2) — so this is a
# legitimate way to run the whole demo with nothing signed up for yet.

# From the Razorpay Dashboard (razorpay.com) → Settings → API Keys, with the
# dashboard in TEST MODE. Must start with rzp_test_ — a rzp_live_ key is
# rejected at startup on purpose (SRS 23.4).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard → Settings → Webhooks → create a webhook, point it at
# {your public tunnel URL}/api/webhooks/razorpay, select the events you need
# (payment.failed, payment_link.paid, invoice.*, subscription.* as relevant),
# and copy the secret it gives you. Needed only if you want real webhook
# delivery; without it you can still poll/backfill.
RAZORPAY_WEBHOOK_SECRET=

# Must stay "test" — Load() refuses to start otherwise (SRS 5.2, 23.4).
RAZORPAY_MODE=test

# Where Razorpay redirects the customer after a payment link is paid.
# For local dev this can stay as-is; for a real demo it should be a URL
# Razorpay can actually reach the customer's browser back to (usually just
# your deployed frontend origin — the redirect target itself doesn't need to
# be internet-reachable the way a webhook does).
PUBLIC_APP_URL=http://localhost:3000

# From Google AI Studio (aistudio.google.com) → Get API key. Free tier is
# enough for demo volume. Without this, all four agents use their
# deterministic fallback paths — same JSON contracts, no model call.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# TIER 3 — safe to leave at their defaults
# ============================================================
APP_ENV=local
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=30s
RUN_MIGRATIONS=true
JWT_TTL=12h
AUTO_RUN_PIPELINE=true
AUTO_EXECUTE_APPROVED=true
SEED_DEMO_DATA=true
VERIFICATION_POLL_INTERVAL=30s
VERIFICATION_TIMEOUT=30m
RAZORPAY_TIMEOUT=15s
RAZORPAY_MAX_RETRIES=2
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=20s
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.1
GEMINI_RETRIES=1
