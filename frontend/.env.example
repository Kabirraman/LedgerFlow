# --- LEDGERFLOW web console ---
#
# Note what is NOT here: no Razorpay key, no Gemini key, no webhook secret. The
# browser bundle never receives a credential, and this app never calls Razorpay or
# Gemini — it calls the LEDGERFLOW API, which holds those keys server-side
# (SRS 19.1, 23.4). If you find yourself wanting to add a NEXT_PUBLIC_ variable
# holding a secret, that is the bug.

# Where the Go API lives, as seen from the Next.js *server* process.
# Under Docker Compose this is the service name; locally it is localhost.
# This value is read only on the server: no browser request is ever sent to it
# directly, so it does not need to be reachable from the user's machine.
LEDGERFLOW_API_URL=http://localhost:8080

# Secret used to sign nothing — deliberately absent. The session cookie holds the
# JWT minted by the Go API, which is already signed by JWT_SECRET there. Adding a
# second signing secret here would create a second thing that can be wrong.

# Cookie hardening. Set to 1 in any deployment served over HTTPS, which forces the
# Secure attribute on the session cookie. Left at 0 for plain-HTTP local
# development, because a Secure cookie over http:// is silently dropped and the
# symptom is "login appears to work but every page says logged out".
LEDGERFLOW_COOKIE_SECURE=0

# Node environment. `production` in the Docker image.
NODE_ENV=development
