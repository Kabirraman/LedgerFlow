# Dependencies
node_modules/
**/node_modules/

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local

# Next.js build output — machine-specific, huge, and regenerated by `npm run build`
frontend/.next/
frontend/.next-dev/
frontend/.next-verify/
frontend/out/
frontend/*.tsbuildinfo

# Go build artifacts
backend/bin/
backend/*.out

# Editor / OS
.DS_Store
*.swp

# Local AI tool config/history — not part of the project
.claude/
